---
import BasicLayout from "./BasicLayout.astro"

interface Props {
    title: string;
    genSidebar: boolean;
}

const { title, genSidebar } = Astro.props;
---

<BasicLayout title={title} genSidebar={genSidebar}>
    <div class="main-wrapper">
        <slot />
    </div>
</BasicLayout>

<style>
    .main-wrapper {
        margin: 0 auto;
        padding: 2em 0;
        overflow-y: auto;
        max-width: 100%;
        width: 90%;
    }
</style>