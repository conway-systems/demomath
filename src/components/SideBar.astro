---
import MenuContent from "./MenuContent.astro";

const { items, currentPath } = Astro.props;
---

<button class="sidebar-toggle" aria-controls="sidebar" aria-expanded="false">
    Sidebar
</button>

<div id="sidebar-backdrop" class="backdrop" aria-hidden="false"></div>

<aside class="sidebar">
    <MenuContent items={Astro.props.items} currentPath={Astro.props.currentPath}/>
</aside>


<style>
    :root {
        --top-bar-height: 55px;
        --sidebar-width: min(80vw, 300px);
    }

    .backdrop {
        position: fixed;
        top: var(--top-bar-height);
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.4);
        z-index: 90;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }
    .backdrop.is-active {
        opacity: 1;
        pointer-events: auto;
    }

    .sidebar {
        position: fixed;
        top: var(--top-bar-height);
        left: 0;
        bottom: 0;
        width: var(--sidebar-width);
        background-color: var(--background-color, #f9f9f9);
        z-index: 100;
        overflow-y: auto;
        box-shadow: 2px 0 8px rgba(0, 0, 0, 0.15);
    }

    .sidebar-toggle {
        position: sticky;
        top: calc(10px + var(--top-bar-height));
        left: calc(10px + var(--sidebar-width));
        z-index: 110;
    }
</style>