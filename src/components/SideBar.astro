---
import MenuContent from "./MenuContent.astro";
import SearchDropdownAstroComponent from "./SearchDropdown.astro";

const maxElements: number = 5;
---

<button class="sidebar-toggle" id="sidebar-toggler" aria-controls="sidebar" aria-expanded="true">
    Sidebar
</button>


<div id="sidebar-backdrop" class="backdrop" aria-hidden="false"></div>

<aside class="sidebar" id="sidebar">
    <div class="search-container">
        <input type="search" id="sidebar-search" placeholder="Search..." />
        <button id="sidebar-search-button">Go</button>
    </div>
    <SearchDropdownAstroComponent items={Astro.props.items} currentPath={Astro.props.currentPath} id="sidebar" maxElements={maxElements} />
    <hr style="margin: 0px 1em;">
    <MenuContent items={Astro.props.items} currentPath={Astro.props.currentPath} />
</aside>


<script>
    import { searchDropdown } from "../utils/navigation";

    const button = document.getElementById('sidebar-toggler');

    button?.addEventListener('click', () => {
        const currentState = localStorage.getItem('sidebar-is-open');
        const newState = currentState === 'open' ? 'closed' : 'open'
        localStorage.setItem('sidebar-is-open', newState);
        document.documentElement.setAttribute('sidebar-is-open', newState);
    });

    const search_bar = document.getElementById('sidebar-search') as HTMLInputElement;
    const search_button = document.getElementById('sidebar-search-button');

    const dropdown = document.getElementById('search-dropdown-sidebar');
    if (!dropdown) throw "Could not find element with id 'search-dropdown-sidebar'";
    const maxElements = Number(dropdown.dataset.maxElements);

    search_button?.addEventListener('click', () => {
        searchDropdown(dropdown, search_bar.value, maxElements);
    })
    search_bar?.addEventListener('input', () => {
        searchDropdown(dropdown, search_bar.value, maxElements);
    })
</script>


<style>
    .backdrop {
        position: fixed;
        top: var(--top-bar-height);
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.4);
        z-index: 90;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }
    html[sidebar-is-open="open"] .backdrop {
        opacity: 1;
        pointer-events: auto;
    }

    .sidebar {
        position: fixed;
        top: var(--top-bar-height);
        left: calc(-1 * var(--sidebar-width));
        bottom: 0;
        width: var(--sidebar-width);
        background-color: var(--background-color, #f9f9f9);
        z-index: 100;
        overflow-y: auto;
        box-shadow: 2px 0 8px rgba(0, 0, 0, 0.15);
        transition: left 0.3s ease;
    }
    html[sidebar-is-open="open"] .sidebar {
        left: 0px;
    }

    .sidebar-toggle {
        position: fixed;
        top: calc(10px + var(--top-bar-height));
        left: 10px;
        z-index: 110;
        transition: left 0.3s ease;
    }
    html[sidebar-is-open="open"] .sidebar-toggle {
        left: calc(10px + var(--sidebar-width));
    }

    .sidebar .search-container {
        position: relative;
        margin: 1em;
        width: calc(100% - 2em);
        display: grid;
        grid-template-columns: auto auto;
        grid-gap: 10px;
        margin-bottom: 0;
    }
    .sidebar .search-container input {
        width: 100%;
        padding: 2px;
    }
    .sidebar .search-container button {
        position: relative;
    }
</style>