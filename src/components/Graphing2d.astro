<div class="content-container">
    <div class="left-container">
        <div class="expression-bar">

        </div>
        <div class="expression-container" id="expression-container">
            
        </div>
    </div>
    <div id="graph-canvas" class="graph-container">
        <canvas />
    </div>
</div>

<style>
    :root {
        --menu-background-color: #f0f0f0;
        --menu-background-image: linear-gradient(#e0e0e0, #f0f0f0);
        --expression-input-margin: 15px;
    }

    .content-container {
        display: grid;
        grid-template-columns: 25% auto;
        height: 100%;
        box-sizing: border-box;
        position: absolute;
    }

    .left-container {
        width: 100%;
        height: 100%;
        box-shadow: 0 2px 6px 0 rgba(0,0,0,.3);
    }

    .expression-bar {
        height: 50px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.2);
        background: var(--menu-background-color);
        background: var(--menu-background-image);
    }

    .expression-container {
        width: 100%;
    }

    .graph-container {
        width: 100%;
        height: 100%;
    }

    .graph-container canvas {
        width: 100%;
        height: 100%;
    }
</style>

<style is:global>
    .expression {
        display: grid;
        border-bottom: 1px solid rgba(0, 0, 0, 0.2);
        grid-template-columns: 40px auto;
        width: 100%
    }

    .expression-left {
        border-right: 1px solid rgba(0, 0, 0, 0.2);
        background: var(--menu-background-color);
    }

    .expression input {
        width: calc(100% - 2 * var(--expression-input-margin));
        padding: 0;
        border: 0;
        margin: var(--expression-input-margin) 0 var(--expression-input-margin) var(--expression-input-margin);
        background: none;
        font-size: large;
    }
    .expression input:focus {
        outline: none;
    }
</style>

<script>
    import { ExpressionManager } from "../utils/graphing";

    const expressionContainer = document.getElementById('expression-container');
    if (!expressionContainer) throw "could not find element with id 'expression-container'";

    let exprManager = new ExpressionManager(expressionContainer);
    exprManager.addExpression(exprManager.genExpressionID());
</script>